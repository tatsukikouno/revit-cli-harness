<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <PackageVersion>
      <PrivateAssets>none</PrivateAssets>
    </PackageVersion>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- JSON serialization -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Revit API reference assemblies (compile-time only; Revit supplies the real DLLs at runtime) -->
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.40" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.40" />
  </ItemGroup>
</Project>
