<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <PackageVersion>
      <PrivateAssets>none</PrivateAssets>
    </PackageVersion>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- JSON serialization -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Revit API reference assemblies (compile-time only; Revit supplies the real DLLs at runtime) -->
    <!-- Used by RevitHarness.Addin, selected by Configuration suffix (R24/R25/R26); R24 is also the
         fallback for a plain "Debug"/"Release" Configuration with no R2x suffix -->
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.40" Condition="$(Configuration.EndsWith('R24')) Or (!$(Configuration.EndsWith('R25')) And !$(Configuration.EndsWith('R26')))" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.0" Condition="$(Configuration.EndsWith('R25'))" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.0" Condition="$(Configuration.EndsWith('R26'))" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.40" Condition="$(Configuration.EndsWith('R24')) Or (!$(Configuration.EndsWith('R25')) And !$(Configuration.EndsWith('R26')))" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.0" Condition="$(Configuration.EndsWith('R25'))" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.0" Condition="$(Configuration.EndsWith('R26'))" />
  </ItemGroup>
</Project>
