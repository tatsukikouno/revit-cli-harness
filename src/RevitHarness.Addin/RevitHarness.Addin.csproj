<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Configurations>Debug R24;Release R24;Debug R25;Release R25;Debug R26;Release R26;Debug R27;Release R27</Configurations>

    <!-- RevitYearSuffix and TargetFramework come from ..\RevitYear.props (imported by Directory.Build.props). -->

    <RootNamespace>RevitHarness.Addin</RootNamespace>
    <AssemblyName>RevitHarness.Addin</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <!-- Revit loads this DLL directly (not via the .NET host), so package dependencies must be
         physically copied next to it rather than resolved from deps.json/the NuGet cache -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- RevitWindowCapture needs System.Drawing; on net8.0-windows it ships with the Windows Forms reference assemblies -->
  <PropertyGroup Condition="'$(RevitYearSuffix)'!='R24'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitYearSuffix)'=='R24'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- net8.0-windows resolves WPF assemblies automatically via UseWPF; net48 needs them listed explicitly -->
  <ItemGroup Condition="'$(RevitYearSuffix)'=='R24'">
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitHarness.Dialogs.Shared\RevitHarness.Dialogs.Shared.csproj" />
    <ProjectReference Include="..\RevitHarness.Contracts\RevitHarness.Contracts.csproj" />
    <ProjectReference Include="..\RevitHarness.Lookup\RevitHarness.Lookup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RevitHarness.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Debug settings -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Autodesk\Revit 20$(RevitYearSuffix.Substring(1))\Revit.exe</StartProgram>
  </PropertyGroup>
</Project>
