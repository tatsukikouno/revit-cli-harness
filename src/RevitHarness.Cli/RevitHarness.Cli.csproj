<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Must stay a plain (non-Windows-suffixed) TFM: PackAsTool rejects TargetPlatformIdentifier-
         bearing TargetFrameworks like net8.0-windows (NETSDK1146). -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RevitHarness.Cli</RootNamespace>
    <AssemblyName>revit-harness</AssemblyName>

    <!-- dotnet tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>revit-harness</ToolCommandName>
    <PackageId>RevitHarness.Cli</PackageId>
    <Description>CLI tool for RevitHarness - installs and manages the RevitHarness add-in for Revit</Description>
    <PackageTags>revit;testing;harness;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- License stays an SPDX expression (MIT, from Directory.Build.props); NuGet rejects setting both
         PackageLicenseExpression and PackageLicenseFile. LICENSE and THIRD-PARTY-NOTICES.md are packed as plain files. -->

    <!-- .NET 8 settings -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- Embed addin files as resources, one set per supported Revit year -->
  <ItemGroup>
    <EmbeddedResource Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R24\*.dll"
                      Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R24\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R24\RevitAPIUI.dll"
                      LogicalName="2024/%(Filename)%(Extension)"
                      Condition="Exists('..\RevitHarness.Addin\bin\x64\$(Configuration) R24')" />
    <EmbeddedResource Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R25\*.dll"
                      Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R25\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R25\RevitAPIUI.dll"
                      LogicalName="2025/%(Filename)%(Extension)"
                      Condition="Exists('..\RevitHarness.Addin\bin\x64\$(Configuration) R25')" />
    <EmbeddedResource Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R26\*.dll"
                      Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R26\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R26\RevitAPIUI.dll"
                      LogicalName="2026/%(Filename)%(Extension)"
                      Condition="Exists('..\RevitHarness.Addin\bin\x64\$(Configuration) R26')" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\RevitHarness.Addin\RevitHarness.addin" Link="Resources\RevitHarness.addin" LogicalName="RevitHarness.addin" />
  </ItemGroup>

  <!-- Ensure Addin project is built first. SkipGetTargetFrameworkProperties avoids MSBuild's TFM
       compatibility check, which would otherwise hard-fail when Addin resolves to net8.0-windows
       (R25/R26) while this project stays plain net8.0 (required by PackAsTool, see above). -->
  <ItemGroup>
    <ProjectReference Include="..\RevitHarness.Addin\RevitHarness.Addin.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
