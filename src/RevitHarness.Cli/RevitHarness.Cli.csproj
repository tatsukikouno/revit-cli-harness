<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Must stay a plain (non-Windows-suffixed) TFM: PackAsTool rejects TargetPlatformIdentifier-
         bearing TargetFrameworks like net10.0-windows (NETSDK1146). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RevitHarness.Cli</RootNamespace>
    <AssemblyName>revit-harness</AssemblyName>

    <!-- dotnet tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>revit-harness</ToolCommandName>
    <PackageId>RevitHarness.Cli</PackageId>
    <Description>CLI tool for RevitHarness - installs and manages the RevitHarness add-in for Revit</Description>
    <PackageTags>revit;testing;harness;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- .NET 10 settings -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- The Addin (one build per supported Revit year) and the dialog watcher are built from here,
       then their outputs are added as items inside the target so the globs see the fresh output.
       TargetFramework is removed from the inherited global properties: `dotnet pack` re-enters this
       project with TargetFramework=net10.0 as a global property, which would otherwise override the
       Addin's per-year TFM (net48 / net8.0-windows / net10.0-windows) and fail with NETSDK1136. Each year restores
       right before its build because all years share one obj\project.assets.json. -->
  <Target Name="BundleAddinAndWatcher" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration) R24;Platform=x64;BundleRestore=true"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj"
             Properties="Configuration=$(Configuration) R24;Platform=x64"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration) R25;Platform=x64;BundleRestore=true"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj"
             Properties="Configuration=$(Configuration) R25;Platform=x64"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration) R26;Platform=x64;BundleRestore=true"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj"
             Properties="Configuration=$(Configuration) R26;Platform=x64"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration) R27;Platform=x64;BundleRestore=true"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.Addin\RevitHarness.Addin.csproj"
             Properties="Configuration=$(Configuration) R27;Platform=x64"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.DialogWatcher\RevitHarness.DialogWatcher.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=x64;BundleRestore=true"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\RevitHarness.DialogWatcher\RevitHarness.DialogWatcher.csproj"
             Properties="Configuration=$(Configuration);Platform=x64"
             RemoveProperties="TargetFramework" />
    <ItemGroup>
      <AddinFile24 Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R24\*.dll" Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R24\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R24\RevitAPIUI.dll" />
      <EmbeddedResource Include="@(AddinFile24)" LogicalName="2024/%(Filename)%(Extension)" />
      <AddinFile25 Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R25\*.dll" Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R25\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R25\RevitAPIUI.dll" />
      <EmbeddedResource Include="@(AddinFile25)" LogicalName="2025/%(Filename)%(Extension)" />
      <AddinFile26 Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R26\*.dll" Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R26\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R26\RevitAPIUI.dll" />
      <EmbeddedResource Include="@(AddinFile26)" LogicalName="2026/%(Filename)%(Extension)" />
      <AddinFile27 Include="..\RevitHarness.Addin\bin\x64\$(Configuration) R27\*.dll" Exclude="..\RevitHarness.Addin\bin\x64\$(Configuration) R27\RevitAPI.dll;..\RevitHarness.Addin\bin\x64\$(Configuration) R27\RevitAPIUI.dll" />
      <EmbeddedResource Include="@(AddinFile27)" LogicalName="2027/%(Filename)%(Extension)" />
      <WatcherFile Include="$(WatcherOutput)**\*" Exclude="$(WatcherOutput)**\*.pdb" />
      <Content Include="@(WatcherFile)" Link="watcher\%(RecursiveDir)%(Filename)%(Extension)"
               Pack="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="..\RevitHarness.Addin\RevitHarness.addin" Link="Resources\RevitHarness.addin" LogicalName="RevitHarness.addin" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitHarness.Dialogs.Shared\RevitHarness.Dialogs.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The dialog watcher and the SKILLs ship as plain files next to the CLI (tools/net10.0/any/watcher
       and /skills in the nupkg); `revit-harness install` copies them out. -->
  <PropertyGroup>
    <WatcherOutput>..\RevitHarness.DialogWatcher\bin\x64\$(Configuration)\net10.0-windows\</WatcherOutput>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)"
             Pack="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
